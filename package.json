{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@sosarium/monorepo",
  "description": "View and edit Ultima Online files.",
  "version": "0.0.0",
  "homepage": "https://sosarium.com",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "check": "biome check . && turbo typecheck test",
    "clean": "turbo run clean",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "26.6.6",
    "lefthook": "2.2.2",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "packageManager": "bun@1.4.4"
}
