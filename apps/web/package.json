    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/devtools-vite": "0.8.6",
    "@tanstack/router-plugin": "1.168.48",
